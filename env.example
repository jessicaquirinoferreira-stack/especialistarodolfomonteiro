# GEMINI_API_KEY: Required for Gemini AI API calls if server-side AI features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# BLOB_READ_WRITE_TOKEN: Optional Vercel Blob token for production cloud media uploads.
# When omitted in local development, uploaded media is stored under /public/uploads.
BLOB_READ_WRITE_TOKEN=""
